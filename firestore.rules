rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rules for standard users collections
    match /users/{userId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      
      // History subcollection
      match /history/{documentId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
      
      // Favorited styles subcollection
      match /favorited_styles/{documentId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // AI 180 Scans subcollection (flattened)
    match /users/{userId}/ai180_scans/{documentId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // AI 180 Styles subcollection (flattened)
    match /users/{userId}/ai180_styles/{documentId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Rules for 360 viewer credits and ledgers
    match /users360/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Transactions subcollection
      match /transactions/{documentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
